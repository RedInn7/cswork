  "problem": {
    "id": "oa-xperi-2",
    "courseId": "gomall",
    "lessonId": "00-overview",
    "title": "Xperi OA #2：使两数相等",
    "difficulty": "简单",
    "tags": [
      "数学",
      "辗转相除"
    ],
    "description": "有两个正整数A和B，要通过若干次操作使A与B相等。每次操作：如果A大于B，则A=A−B；如果B大于A，则B=B−A。每次操作的代价为1。求使A等于B的总代价。",
    "input": "一行两个空格分隔的整数A和B。1≤A,B≤10^18。",
    "output": "输出一个整数，表示总代价。",
    "explanation": "样例1：A=7，B=9。B=9−7=2，A=7−2=5，A=5−2=3，A=3−2=1，B=2−1=1，共5次。\n样例2：A与B初始相等，代价0。\n样例3：12→9→6→3，共3次。",
    "hints": [
      "操作是确定的，只需计算次数。",
      "对同一个数的连续减法可以用除法一次算完。",
      "整除时最后一次减到相等就停止，比商少一次。"
    ],
    "timeLimit": 2,
    "memoryLimit": 262144,
    "outputLimit": 1024,
    "checker": "tokens",
    "languages": [
      "python",
      "go",
      "java",
      "cpp"
    ]
  },
  "cases": [
    {
