    "courseId": "gomall",
    "lessonId": "00-overview",
    "title": "Transform String",
    "difficulty": "简单",
    "tags": [
      "OA",
      "Jane Street",
      "字符串",
      "栈"
    ],
    "description": "字符串只含 A、B、C、D。可反复删除任意相邻的 A/B（任意顺序）或 C/D（任意顺序）。输出任意无法继续删除的结果。\n\n本站补充标准输入输出协议；不代表原站函数题原有该协议。",
    "input": "输入一行字符串 S；空串用空行表示。",
    "output": "输出一个不可再约简的字符串；若结果为空输出空行。",
    "explanation": "完整思路、证明和复杂度见配套讲义。",
    "hints": [
      "只需检查新字符与当前结果末尾是否构成可删除对。"
    ],
    "timeLimit": 3,
    "memoryLimit": 262144,
    "outputLimit": 8192,
    "checker": "tokens",
    "languages": [
      "python",
      "go",
      "java",
      "cpp"
    ]
  },
