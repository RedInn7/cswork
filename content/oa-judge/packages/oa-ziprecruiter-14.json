  "problem": {
    "id": "oa-ziprecruiter-14",
    "courseId": "gomall",
    "lessonId": "00-overview",
    "title": "ZipRecruiter OA #14：字符互不相同的连续三元组",
    "difficulty": "简单",
    "tags": [
      "字符串",
      "滑动窗口"
    ],
    "description": "给定只含小写英文字母的字符串s，统计s中由互不相同字符组成的连续三元组个数。换言之，统计满足s[i]、s[i+1]、s[i+2]两两不同的下标i的个数。",
    "input": "一行字符串s。1≤s的长度≤1000，只含小写英文字母。",
    "output": "输出一个整数。",
    "explanation": "样例1：s=\"abcdaaae\"，i=0（abc）、i=1（bcd）、i=2（cda）满足；i=3（daa）中s[4]与s[5]相同，之后的三元组也都含重复字符，答案3。\n样例2：s=\"abacaba\"，只有i=1（bac）和i=3（cab）满足，其他三元组都含两个a，答案2。\n样例3：s=\"xyz\"只有一个三元组且满足，答案1。",
    "hints": [
      "只需检查每个长度为3的窗口。",
      "三个字符两两不同需要比较三对，别漏掉首尾两个字符。"
    ],
    "timeLimit": 2,
    "memoryLimit": 262144,
    "outputLimit": 1024,
    "checker": "tokens",
    "languages": [
      "python",
      "go",
      "java",
      "cpp"
    ]
  },
