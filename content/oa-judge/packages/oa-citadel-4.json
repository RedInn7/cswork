  "problem": {
    "id": "oa-citadel-4",
    "courseId": "gomall",
    "lessonId": "00-overview",
    "title": "不同回文子串的数量",
    "difficulty": "中等",
    "tags": [
      "OA",
      "Citadel"
    ],
    "description": "统计不同文本的回文子串数，多次出现只算一次。原OCR长例abcddcbabcdcdaadcdcbabcddcb正确为26而不是27，原列举含重复及不存在的子串。\n\n输入输出协议由本站整理；缺失数值界和来源笔误恢复均已明示。",
    "input": "一行小写串，完整OCR范围1≤长度≤5000。",
    "output": "输出一个整数答案。",
    "explanation": "三个公开样例的输出依次为：7；5；26。独立枚举或直接模拟已核对这些答案。",
    "hints": [
      "建立回文树，两特殊根长度−1和0；每加入字符，沿最长回文后缀的失败链接找可扩展节点，建立新回文及失败链接。"
    ],
    "timeLimit": 6,
    "memoryLimit": 262144,
    "outputLimit": 4096,
    "checker": "tokens",
    "languages": [
      "python",
      "go",
      "java",
      "cpp"
    ]
  },
  "cases": [
