  "problem": {
    "id": "oa-jpmorgan-chase-10",
    "courseId": "gomall",
    "lessonId": "00-overview",
    "title": "两种规模队伍的最少队数",
    "difficulty": "中等",
    "tags": [
      "OA",
      "JPMorgan Chase"
    ],
    "description": "每人恰好属于一队，每队人数为a或b。将p人全部分组，求最少队数；无解输出−1。\n\n输入输出协议由本站整理，缺失数值界明确标为本站补充。",
    "input": "一行a b p；完整原界1≤a,b,p≤100000。",
    "output": "输出一个整数答案。",
    "explanation": "三个公开样例的输出依次为：2；-1；1。独立枚举或直接模拟已核对这些答案。",
    "hints": [
      "枚举a人队数量，剩余人数若能整除b即可组成方案，取队数最少。"
    ],
    "timeLimit": 6,
    "memoryLimit": 262144,
    "outputLimit": 4096,
    "checker": "tokens",
    "languages": [
      "python",
      "go",
      "java",
      "cpp"
    ]
  },
  "cases": [
