  "problem": {
    "id": "oa-citadel-21",
    "courseId": "gomall",
    "lessonId": "00-overview",
    "title": "按出现位置计数的回文子串",
    "difficulty": "中等",
    "tags": [
      "OA",
      "Citadel"
    ],
    "description": "统计所有回文子串，相同文本出现在不同位置要分别计数。原正文截断，但aaa→6及列举明确此规则，与4号不同文本计数不同。\n\n输入输出协议由本站整理；缺失数值界和来源笔误恢复均已明示。",
    "input": "一行小写串，原完整界1≤长度≤1000。",
    "output": "输出一个整数答案。",
    "explanation": "三个公开样例的输出依次为：3；6；6。独立枚举或直接模拟已核对这些答案。",
    "hints": [
      "枚举每个字符中心和相邻字符间中心，向两边同步扩展，每次匹配贡献一个回文。"
    ],
    "timeLimit": 6,
    "memoryLimit": 262144,
    "outputLimit": 4096,
    "checker": "tokens",
    "languages": [
      "python",
      "go",
      "java",
      "cpp"
    ]
  },
  "cases": [
    {
