    "id": "oa-bloomberg-1",
    "courseId": "gomall",
    "lessonId": "00-overview",
    "title": "连续正整数之和的表示数量",
    "difficulty": "中等",
    "tags": [
      "OA",
      "Bloomberg"
    ],
    "description": "给定num，统计用至少两个连续正整数相加得到num的不同方式。\n\n输入输出由本站整理。",
    "input": "一行整数，1≤num≤10¹²。",
    "output": "输出表示方式数。",
    "explanation": "15有1+2+3+4+5、4+5+6、7+8三种；2没有；9有2+3+4、4+5两种。",
    "hints": [
      "去掉num中的所有因子2，分解剩余奇数，其正约数数量减1就是答案。"
    ],
    "timeLimit": 4,
    "memoryLimit": 262144,
    "outputLimit": 4096,
    "checker": "tokens",
    "languages": [
      "python",
      "go",
      "java",
      "cpp"
    ]
  },
