      "name": "样例 1",
      "input": "4 4 2\n1\thi #a #b\n2\t#a !!!\n3\tno tag\n4\t#b #b\n",
      "expectedOutput": "#b\n#a\n",
      "hidden": false,
      "weight": 1
    },
