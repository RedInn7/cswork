  "problem": {
    "id": "oa-f5-1",
    "courseId": "gomall",
    "lessonId": "00-overview",
    "title": "Top 3 Trending Hashtags in a Time Window",
    "difficulty": "中等",
    "tags": [
      "OA",
      "F5"
    ],
    "description": "统计闭区间时间窗内推文里的 hashtag 出现次数，按次数降序、标签字典序升序返回前三名。\n\n本站标准输入输出格式与补充边界以本题说明为准。",
    "input": "第一行 n currentTime timeWindow（n≤2×10^5，文本总长≤10^6，时间戳与时间窗非负且≤10^9）。后续 n 行为 timestamp、制表符、tweet；标签由 # 开始，后接 ASCII 字母/数字/下划线。",
    "output": "每行输出一个 hashtag，保留开头的 #；无标签时输出空内容。",
    "explanation": "只扫描时间窗内文本，逐字符识别标签并计数，再按 `(-count, tag)` 排序。总扫描 O(文本总长)，排序 O(H log H)。",
    "hints": [
      "只扫描时间窗内文本，逐字符识别标签并计数，再按 `(-count, tag)` 排序。总扫描 O(文本总长)，排序 O(H log H)。"
    ],
    "timeLimit": 6,
    "memoryLimit": 262144,
    "outputLimit": 32768,
    "checker": "tokens",
    "languages": [
      "python",
      "go",
      "java",
      "cpp"
    ]
  },
  "cases": [
    {
      "name": "样例 1",
      "input": "4 4 2\n1\thi #a #b\n2\t#a !!!\n3\tno tag\n4\t#b #b\n",
      "expectedOutput": "#b\n#a\n",
      "hidden": false,
      "weight": 1
    },
    {
