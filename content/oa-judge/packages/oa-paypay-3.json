    "lessonId": "00-overview",
    "title": "Find Maximum Two-Digit Fragment",
    "difficulty": "中等",
    "tags": [
      "OA",
      "PayPay"
    ],
    "description": "在数字串所有长度为 2 的连续片段中，求按十进制数值解释后的最大值。",
    "input": "一行数字串 S，长度 2..100000，字符仅 0..9。",
    "output": "输出最大的两位片段数值，前导零按整数解析。",
    "explanation": "从题目规则直接推导线性扫描/动态规划解法；样例与独立构造的 oracle 已逐例核对。",
    "hints": [
      "先把题面中的操作或约束转成确定的数组/状态转移，再分析边界。"
    ],
    "timeLimit": 6,
    "memoryLimit": 262144,
    "outputLimit": 4096,
    "checker": "tokens",
    "languages": [
      "python",
      "go",
      "java",
      "cpp"
    ]
  },
