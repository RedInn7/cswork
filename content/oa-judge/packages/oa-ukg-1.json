  "problem": {
    "id": "oa-ukg-1",
    "courseId": "gomall",
    "lessonId": "00-overview",
    "title": "Minimum Flips to Match Expected Binary Values in a Tree",
    "difficulty": "中等",
    "tags": [
      "OA",
      "Ukg"
    ],
    "description": "给定以0为根的无向树。对节点 u 执行操作会翻转 u 子树中编号奇偶性与 u 相同的所有节点。求最少操作次数，使 initial 全部变成 expected。\n\n本站明确的标准输入输出格式与补充约束属于在线版本定义，不冒充来源原始约束。",
    "input": "输入 N（1..100000）、N−1 条 0-based 边、initial 和 expected 两个二进制数组。",
    "output": "输出最少操作数。",
    "explanation": "从根开始遍历。记录祖先操作分别对偶数编号、奇数编号节点造成的翻转奇偶数；当前节点仍不匹配时必须在此执行一次操作。",
    "hints": [
      "从根开始遍历。记录祖先操作分别对偶数编号、奇数编号节点造成的翻转奇偶数；当前节点仍不匹配时必须在此执行一次操作。"
    ],
    "timeLimit": 8,
    "memoryLimit": 262144,
    "outputLimit": 4096,
    "checker": "tokens",
    "languages": [
      "python",
      "go",
      "java",
      "cpp"
    ]
  },
  "cases": [
