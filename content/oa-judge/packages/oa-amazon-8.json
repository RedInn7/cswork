  "problem": {
    "id": "oa-amazon-8",
    "courseId": "gomall",
    "lessonId": "00-overview",
    "title": "不同整除商的总和",
    "difficulty": "中等",
    "tags": [
      "OA",
      "Amazon",
      "整除分块",
      "数学"
    ],
    "description": "给定正整数 n，考虑所有正整数 k 产生的 floor(n/k)。对出现过的不同商值求和。k 可以大于 n，此时商为0，但不会影响总和。每个商值只计一次。\n\n标准输入格式、样例和评测数据由 CSWork 编写。",
    "input": "输入 n（1..10¹⁰），使用64位整数保存结果。",
    "output": "输出一个整数，表示题目要求的答案。",
    "explanation": "n=5时不同商为5、2、1、0，总和为8。",
    "hints": [
      "从 k=1 开始。当前商 q=n//k 在整个区间 [k,n//q] 内不变，加一次q后直接跳到 n//q+1。"
    ],
    "timeLimit": 3,
    "memoryLimit": 262144,
    "outputLimit": 4096,
    "checker": "tokens",
    "languages": [
      "python",
      "go",
      "java",
      "cpp"
    ]
  },
  "cases": [
