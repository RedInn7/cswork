  "problem": {
    "id": "oa-abaka-ai-1",
    "courseId": "gomall",
    "lessonId": "00-overview",
    "title": "Task Scheduling (Parallel Same-Type with Memory Limit)",
    "difficulty": "中等",
    "tags": [
      "OA",
      "Abaka.ai"
    ],
    "description": "每个任务耗时1。可将两个任务并行处理，当且仅当类型相同且两者内存和≤maxMemory；其余任务单独处理。求最短总处理时间。\n\n本站明确的标准输入输出格式与补充约束属于在线版本定义，不冒充来源原始约束。",
    "input": "输入 N、maxMemory、N 个 taskMemory 和 N 个 taskType。1≤N≤200000，1≤taskMemory[i]≤maxMemory≤10^9，1≤taskType[i]≤10^9。本站限定每个任务可单独运行，即使其内存不适合与其他任务并行。",
    "output": "输出最少时间单位数。",
    "explanation": "按 taskType 分组。每组内存排序后从最小和最大开始配对；和不超过上限时成对并行，否则最大任务只能单独运行。",
    "hints": [
      "按 taskType 分组。每组内存排序后从最小和最大开始配对；和不超过上限时成对并行，否则最大任务只能单独运行。"
    ],
    "timeLimit": 8,
    "memoryLimit": 262144,
    "outputLimit": 4096,
    "checker": "tokens",
    "languages": [
      "python",
      "go",
      "java",
      "cpp"
    ]
  },
