    "lessonId": "00-overview",
    "title": "回文子串计数",
    "difficulty": "中等",
    "tags": [
      "OA",
      "Goldman Sachs",
      "字符串",
      "中心扩展"
    ],
    "description": "给定仅由小写英文字母组成的字符串，统计其中回文子串的出现次数。相同内容出现在不同位置时分别计数。\n\n输入协议、样例与评测数据由 CSWork 按原函数题意整理。",
    "input": "输入一行字符串 s，长度为 1..5000，仅包含小写英文字母。",
    "output": "输出回文子串出现次数。",
    "explanation": "输出按题目规则计算的结果；完整算法说明见题解。",
    "hints": [
      "把每个字符位置和相邻字符间隙分别作为回文中心，向两侧扩展；每次左右字符相同就找到一个回文子串。"
    ],
    "timeLimit": 3,
    "memoryLimit": 262144,
    "outputLimit": 4096,
    "checker": "tokens",
    "languages": [
      "python",
      "go",
      "java",
      "cpp"
    ]
  },
