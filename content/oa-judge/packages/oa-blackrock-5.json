  "problem": {
    "id": "oa-blackrock-5",
    "courseId": "gomall",
    "lessonId": "00-overview",
    "title": "Happy Number",
    "difficulty": "简单",
    "tags": [
      "OA",
      "BlackRock",
      "数学",
      "哈希表"
    ],
    "description": "给定正整数 n，反复将其替换为各位数字的平方和。若过程到达 1 则输出快乐数标记；若进入不含 1 的循环则输出非快乐数标记。\n\n输入协议为本站整理；Road Trip 的数量和距离范围为本站明确补充，不代表原题原有限制。",
    "input": "输入一个整数 n，1≤n≤2147483647。",
    "output": "快乐数输出 1，否则输出 0。",
    "explanation": "思路、正确性证明和复杂度见配套题解。",
    "hints": [
      "先将文字规则转为明确状态，再独立验证边界。"
    ],
    "timeLimit": 3,
    "memoryLimit": 262144,
    "outputLimit": 4096,
    "checker": "exact",
    "languages": [
      "python",
      "go",
      "java",
      "cpp"
    ]
  },
