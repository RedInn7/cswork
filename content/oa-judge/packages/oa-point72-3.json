  "problem": {
    "id": "oa-point72-3",
    "courseId": "gomall",
    "lessonId": "00-overview",
    "title": "子串操作后的字典序最小字符串",
    "difficulty": "中等",
    "tags": [
      "OA",
      "Point72",
      "字符串",
      "贪心"
    ],
    "description": "给定仅含小写英文字母的字符串。必须选择一个非空连续子串，将其中每个字符恰好替换为字母表前一个字符；a 的前一个字符是 z。输出能得到的字典序最小字符串。\n\n题面与约束完整；标准输入输出协议由本站补充。\n\n本站补充标准输入输出协议；不代表原站函数题原有该协议。",
    "input": "输入一行字符串 s（1 ≤ |s| ≤ 100000）。",
    "output": "输出操作后的字符串。",
    "explanation": "题目规则、思路与证明见配套讲义。",
    "hints": [
      "跳过前导 a，随后把遇到的连续非 a 字符都减一；若全串都是 a，只把最后一个 a 变成 z。"
    ],
    "timeLimit": 4,
    "memoryLimit": 262144,
    "outputLimit": 65536,
    "checker": "tokens",
    "languages": [
      "python",
      "go",
      "java",
      "cpp"
    ]
  },
  "cases": [
