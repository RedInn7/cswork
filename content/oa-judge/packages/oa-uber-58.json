  "schemaVersion": 1,
  "problem": {
    "id": "oa-uber-58",
    "courseId": "gomall",
    "lessonId": "00-overview",
    "title": "重复数字分组求和直到稳定",
    "difficulty": "中等",
    "tags": [
      "OA",
      "Uber"
    ],
    "description": "每轮同时把每个连续相同数字组替换成组内数字之和的十进制表示。不断重复，直到不存在相邻相同数字。输入是字符串，前导0保留；多个0求和后变一个0。\n\n本站已明确标准输入输出；源未给出的范围均标明为本站协议。",
    "input": "一行非空数字串。源无长度范围，本站长度1..2000。",
    "output": "输出最终数字串。",
    "explanation": "样例1：999→27、33→6，得到2746，已经稳定。样例2：第一轮12163244仍含44，需继续变为1216328，原站停早了。样例3：0044886→08166→08112→0822→084，答案084，前导0保留。",
    "hints": [
      "逐轮扫描相同字符段，用数字值乘段长计算替代串；若所有段长度均1则停止。"
    ],
    "timeLimit": 4,
    "memoryLimit": 262144,
    "outputLimit": 4096,
    "checker": "tokens",
    "languages": [
      "python",
      "go",
      "java",
      "cpp"
    ]
  },
