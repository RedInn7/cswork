  "problem": {
    "id": "oa-intuit-20",
    "courseId": "gomall",
    "lessonId": "00-overview",
    "title": "套娃后剩余数量",
    "difficulty": "简单",
    "tags": [
      "OA",
      "Intuit"
    ],
    "description": "把较小尺寸的娃娃装进更大尺寸的娃娃；相同尺寸不能互套。全部尽量嵌套后，输出剩下的最少娃娃数。",
    "input": "输入 N（1≤N≤100000），下一行 N 个尺寸（1..100000）。",
    "output": "按题意输出答案；数组题按空格分隔输出。",
    "explanation": "统计每个尺寸的出现次数，答案为最大频次。\n\n正确性：每个嵌套链中每个尺寸至多出现一次，所以出现次数最多的尺寸至少需要同样多条链。反过来把尺寸排序，并按序号轮流分配到该数量的链；同一链尺寸严格增加，所有娃娃均可放入链中。\n\n复杂度：时间 O(N)，空间 O(N)。",
    "hints": [
      "统计每个尺寸的出现次数，答案为最大频次。"
    ],
    "timeLimit": 5,
    "memoryLimit": 262144,
    "outputLimit": 4096,
    "checker": "tokens",
    "languages": [
      "python",
      "go",
      "java",
      "cpp"
    ]
  },
