  "problem": {
    "id": "oa-oracle-1",
    "courseId": "gomall",
    "lessonId": "00-overview",
    "title": "精确求两个小数之和的下取整",
    "difficulty": "中等",
    "tags": [
      "OA",
      "Oracle"
    ],
    "description": "给两个有限十进制数，返回它们和的向下取整。\n\n本站独立整理标准I/O与题解；来源缺失界的补充及样例纠错在协议中明示。",
    "input": "一行两个正十进制数a b。完整原界0.1<a,b<1000000，最多8位小数；本站编码要求有整数部分，不用指数形式。",
    "output": "输出一个整数答案。",
    "explanation": "三个公开样例的输出依次为：4；0；5。独立枚举或直接模拟已核对。",
    "hints": [
      "把每个小数补齐8位后转换为整数，整数相加再除以10^8。"
    ],
    "timeLimit": 6,
    "memoryLimit": 262144,
    "outputLimit": 4096,
    "checker": "tokens",
    "languages": [
      "python",
      "go",
      "java",
      "cpp"
    ]
  },
  "cases": [
