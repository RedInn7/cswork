  "problem": {
    "id": "oa-publicis-sapient-1",
    "courseId": "gomall",
    "lessonId": "00-overview",
    "title": "Get Minimum Time",
    "difficulty": "中等",
    "tags": [
      "OA",
      "Publicis Sapient"
    ],
    "description": "从每层分别往返顶层搬运该层箱子；每件箱子对应一次往返以及 1 分钟装卸。\n\n本站标准输入输出格式与补充边界以本题说明为准。",
    "input": "第一行 n（1≤n≤10^5），第二行 n 个非负整数 boxes[i]（≤10^9），下标 i 对应楼层 i，顶层为 n。",
    "output": "输出最少总分钟数（整数可超过 32 位）。",
    "explanation": "楼层 i 的每个箱子需 `2(n−i)` 分钟往返和 1 分钟装卸，成本线性相加即可。时间 O(n)，常数额外空间。",
    "hints": [
      "楼层 i 的每个箱子需 `2(n−i)` 分钟往返和 1 分钟装卸，成本线性相加即可。时间 O(n)，常数额外空间。"
    ],
    "timeLimit": 6,
    "memoryLimit": 262144,
    "outputLimit": 32768,
    "checker": "tokens",
    "languages": [
      "python",
      "go",
      "java",
      "cpp"
    ]
  },
