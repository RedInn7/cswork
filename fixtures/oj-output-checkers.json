    {
      "name": "string invalid expected rejected",
      "checker": "string-set",
      "actual": "1\na\n",
      "expected": "2\na\na\n",
      "matches": false,
      "actualValid": true,
      "expectedValid": false
    },
    {
      "name": "legacy tokens ASCII whitespace",
      "checker": "tokens",
      "actual": "1 \r\n 2\t",
      "expected": "1 2\n",
      "matches": true
    },
    {
      "name": "legacy tokens preserve order",
      "checker": "tokens",
      "actual": "2 1\n",
      "expected": "1 2\n",
      "matches": false
    },
    {
      "name": "legacy tokens decimal spellings differ",
      "checker": "tokens",
      "actual": "1.0",
