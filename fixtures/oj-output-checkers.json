{
  "protocolVersion": 1,
  "maxOutputBytes": 4194304,
  "maxSetItems": 1000000,
  "countHeader": "canonical nonnegative decimal, no surrounding whitespace",
  "integerElement": "signed decimal digits; leading + and zeroes normalized; duplicates after normalization rejected",
  "cases": [
    {
      "name": "integer order ignored",
      "checker": "int-set",
      "actual": "3\n9 -2 0\n",
      "expected": "3\n0 9 -2\n",
      "matches": true,
      "actualValid": true,
      "expectedValid": true
    },
    {
      "name": "integer decimal normalization",
      "checker": "int-set",
      "actual": "3\n+001 -0002 -0",
      "expected": "3\n1 -2 0\n",
      "matches": true,
      "actualValid": true,
      "expectedValid": true
    },
    {
      "name": "integer CRLF",
      "checker": "int-set",
      "actual": "2\r\n1\t2\r\n",
      "expected": "2\n2 1\n",
      "matches": true,
      "actualValid": true,
      "expectedValid": true
    },
    {
      "name": "integer empty",
      "checker": "int-set",
      "actual": "0\n",
      "expected": "0\n",
      "matches": true,
      "actualValid": true,
      "expectedValid": true
    },
    {
      "name": "integer empty whitespace",
      "checker": "int-set",
      "actual": "0\n \t\n",
      "expected": "0\n",
      "matches": true,
      "actualValid": true,
      "expectedValid": true
    },
    {
      "name": "integer arbitrary precision",
      "checker": "int-set",
      "actual": "2\n9007199254740993 -999999999999999999999999999999\n",
      "expected": "2\n-999999999999999999999999999999 9007199254740993\n",
      "matches": true,
      "actualValid": true,
      "expectedValid": true
    },
    {
      "name": "integer precision difference",
      "checker": "int-set",
      "actual": "1\n9007199254740992\n",
      "expected": "1\n9007199254740993\n",
      "matches": false,
      "actualValid": true,
      "expectedValid": true
    },
    {
      "name": "integer rejects duplicate",
      "checker": "int-set",
      "actual": "2\n1 1\n",
      "expected": "1\n1\n",
      "matches": false,
      "actualValid": false,
      "expectedValid": true
    },
    {
      "name": "integer rejects normalized duplicate",
      "checker": "int-set",
      "actual": "2\n1 +01\n",
      "expected": "1\n1\n",
      "matches": false,
      "actualValid": false,
      "expectedValid": true
    },
    {
      "name": "integer rejects zero duplicate",
      "checker": "int-set",
      "actual": "2\n0 -0\n",
      "expected": "1\n1\n",
      "matches": false,
      "actualValid": false,
      "expectedValid": true
    },
    {
      "name": "integer rejects missing item",
      "checker": "int-set",
      "actual": "2\n1\n",
      "expected": "1\n1\n",
      "matches": false,
      "actualValid": false,
      "expectedValid": true
    },
    {
      "name": "integer rejects extra item",
      "checker": "int-set",
      "actual": "1\n1 2\n",
      "expected": "1\n1\n",
      "matches": false,
      "actualValid": false,
      "expectedValid": true
