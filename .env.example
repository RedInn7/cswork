APP_URL=http://localhost:4317
BETTER_AUTH_SECRET=
ADMIN_EMAILS=
DATABASE_PATH=data/cswork.sqlite
ATTACHMENTS_PATH=data/attachments
MEDIA_PATH=data/media
MEDIA_MAX_BYTES=10737418240
# Production nginx transport only; leave empty for development/staging.
MEDIA_X_ACCEL_PREFIX=
HOST=127.0.0.1
PORT=4317
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
MAIL_FROM=
# Web Push for learning reminders (lib/server/web-push.ts); push stays off while any is empty.
# Web and worker both read them. Generate a key pair once with:
#   node -e "const k=require('crypto').generateKeyPairSync('ec',{namedCurve:'prime256v1'}).privateKey.export({format:'jwk'});console.log('VAPID_PUBLIC_KEY='+Buffer.concat([Buffer.from([4]),Buffer.from(k.x,'base64url'),Buffer.from(k.y,'base64url')]).toString('base64url')+'\nVAPID_PRIVATE_KEY='+k.d)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact the push services can reach, e.g. mailto:ops@example.com
VAPID_SUBJECT=
# Production web only needs OJ_ENABLED=true. Keep the following credentials
# in the worker's separate environment file (see docs/DEPLOYMENT.md).
OJ_ENABLED=false
GO_JUDGE_URL=
GO_JUDGE_TOKEN=
REDIS_URL=
OJ_LANGUAGE_VERSIONS={}
STREAM_ACCOUNT_ID=
STREAM_API_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GOMALL=

# Optional local language broker; install with deploy/language-service/install.sh.
CSWORK_LSP_URL=
CSWORK_LSP_TOKEN=

# Optional AI tutor (hints and code review on the problem page); off while empty.
ANTHROPIC_API_KEY=
# Calls per UTC day across all learners (default 2500; 0 pauses the tutor); per learner up to 85 a day:
# 10 hints, 5 reviews, 20 chats, 5 test sets, 5 debugs, 10 complexity checks, 20 explanations, 10 Ask AI.
AI_TUTOR_DAILY_BUDGET=
# AI mock interviewer calls per UTC day across all learners, apart from the tutor's (default 300; 0 pauses it).
AI_INTERVIEW_DAILY_BUDGET=

# Optional "Join the community" footer link on public pages: a Discord invite or a WeChat
# group QR image, https only; hidden while empty.
COMMUNITY_URL=
