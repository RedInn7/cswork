[Unit]
Description=Back up cswork database and private attachments
[Service]
Type=oneshot
User=cswork
Group=cswork
UMask=0077
EnvironmentFile=/etc/cswork/cswork.env
ExecStart=/opt/cswork/runtime/node /srv/cswork/current/scripts/backup.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cswork
MemoryMax=256M
Nice=10
