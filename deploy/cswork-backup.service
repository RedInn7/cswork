[Unit]
Description=Back up cswork database and private attachments
[Service]
Type=oneshot
User=cswork
Group=cswork
UMask=0077
EnvironmentFile=/etc/cswork/cswork.env
ExecStart=/opt/cswork/runtime/node /srv/cswork/current/scripts/backup.mjs
NoNewPrivileges=true
PrivateTmp=true
# Keep media and backups on the same mount so immutable files can be hard-linked.
# Strict with writable path exceptions creates separate mounts (EXDEV), forcing
# large video copies whose dirty page cache can exhaust this unit's memory limit.
ProtectSystem=full
ReadOnlyPaths=/srv/cswork/releases /opt/cswork
ProtectHome=true
# SQLite judge datasets grow with hidden cases. Leave room for snapshot pages.
MemoryMax=1G
Nice=10
