[Unit]
Description=cswork durable algorithm judge worker
After=network.target docker.service cswork.service
Wants=cswork.service

[Service]
Type=simple
User=cswork
Group=cswork
WorkingDirectory=/srv/cswork/current
EnvironmentFile=/etc/cswork/cswork.env
EnvironmentFile=/etc/cswork/oj.env
ExecStart=/opt/cswork/runtime/node --max-old-space-size=3072 /srv/cswork/current/oj-worker/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cswork

# Large snapshots are admitted exclusively by the worker; ordinary jobs overlap.
# The runner gets three CPUs; retain this one-core cap for Node's coordinator.
MemoryHigh=3G
MemoryMax=4G
CPUQuota=100%
CPUWeight=50
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
