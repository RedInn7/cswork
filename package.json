{
  "name": "cswork",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vinext/dist/cli.js dev",
    "build": "vinext build && vite build --config vite.worker.config.ts && node scripts/package-oj-worker.mjs",
    "start": "node --env-file-if-exists=.env dist/standalone/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit --incremental false",
    "test:integration": "node tests/integration.mjs",
    "worker:start": "node --env-file-if-exists=.env dist/standalone/oj-worker/index.mjs",
    "test:oj-problems": "tsx --test tests/oj-problems.test.ts",
    "test:oj": "tsx --test tests/oj-problems.test.ts tests/oj-submissions.test.ts tests/oj-output-checkers.test.ts tests/oj-result-shapes.test.ts tests/oj-library-gate.test.ts tests/oj-worker-policy.test.ts tests/oj-semantic-checkers.test.ts tests/oj-semantic-integration.test.ts tests/oj-semantic-publisher.test.ts",
    "test:request-lifecycle": "tsx --test tests/request-lifecycle.test.ts",
    "test:platform": "tsx --test --test-concurrency=2 tests/lms.test.ts tests/auth.test.ts tests/commerce.test.ts tests/media-enrollment.test.ts tests/playback-state.test.ts",
    "test:platform-http": "node tests/platform-integration.mjs",
    "test:diagrams": "node --import tsx --test tests/course-diagrams.test.mjs",
    "test:editor": "tsx --test tests/editor-intelligence.test.ts tests/editor-lsp-adapter.test.ts tests/monaco-intelligence.test.ts && node --test tests/language-service.test.mjs tests/language-service-lifecycle.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@monaco-editor/react": "^4.7.0",
    "@shadcn/react": "0.3.0",
    "better-auth": "^1.7.2",
    "better-sqlite3": "12.11.1",
    "bullmq": "^6.3.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "ioredis": "^6.0.0",
    "lucide-react": "1.31.0",
    "mermaid": "11.17.2",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "4.18.0",
    "stripe": "^22.4.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "video.js": "^8.24.0",
    "vinext": "^1.0.0-beta.9",
    "vscode-jsonrpc": "8.2.1",
    "vscode-languageserver-protocol": "3.17.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.29",
    "drizzle-kit": "0.31.10",
    "jsdom": "30.0.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "^8.0.16"
  },
  "type": "module",
  "overrides": {
    "dompurify": "3.4.14"
  }
}
